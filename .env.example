# Application
APP_NAME=AI Jyotish Guru
APP_ENV=development
DEBUG=true
API_VERSION=v1
SECRET_KEY=change-me-to-64-char-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=32-byte-base64-key-for-fernet-encryption

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://jyotish:jyotish_secret@localhost:5432/ai_jyotish_guru
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis (caching, sessions, rate limiting)
REDIS_URL=redis://localhost:6379/0

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048

# Whisper (OpenAI)
WHISPER_MODEL=whisper-1

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-hindi-voice-id
ELEVENLABS_MODEL=eleven_multilingual_v2

# Vedic Astrology / Swiss Ephemeris
ASTROLOGY_PROVIDER=swiss_ephemeris
VEDIC_API_BASE_URL=https://api.vedicastroapi.com/v3
VEDIC_API_KEY=your-vedic-api-key
SWISS_EPHEMERIS_PATH=/usr/share/ephe

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# AWS (optional - S3 for voice/media)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ai-jyotish-guru-media

# Push Notifications (FCM)
FCM_SERVER_KEY=your-fcm-server-key

# Admin
ADMIN_EMAIL=admin@aijyotishguru.com
ADMIN_PASSWORD_HASH=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
VOICE_RATE_LIMIT_PER_MINUTE=10

# Subscription Plans (INR)
PREMIUM_MONTHLY_PRICE=299
PREMIUM_YEARLY_PRICE=2499
FREE_DAILY_CHAT_LIMIT=5
